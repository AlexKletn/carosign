#%PAM-1.0
# Arch example. Compare it with the installed /etc/pam.d/sudo before using it.
# A locked account must still pass faillock when using biometrics.
auth requisite pam_faillock.so preauth
auth [success=2 auth_err=ignore default=1] pam_carosign.so
# Only a confirmed mismatch counts as a failed attempt.
auth [default=ignore] pam_faillock.so authfail
# Continue to the stock password stack on any result other than success.
auth [default=3] pam_permit.so
# Reset the counter only on the biometric success path.
auth requisite pam_faillock.so authsucc
auth required pam_env.so
auth sufficient pam_permit.so
auth include system-auth

account include system-auth
session include system-auth
session optional pam_systemd.so class=none
