[Unit]
Description=CaroSign — системная биометрическая служба
After=local-fs.target

[Service]
Type=exec
User=root
Group=root
RuntimeDirectory=carosignd
RuntimeDirectoryMode=0755
StateDirectory=carosign
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/carosignd --config /etc/carosign/carosignd.conf
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
